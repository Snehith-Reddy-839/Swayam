# MunchMate Backend Environment Configuration Example
PROJECT_NAME="MunchMate — Group Ordering Made Effortless"
API_V1_PREFIX="/api/v1"
SECRET_KEY="munchmate-super-secret-production-grade-key-2026-secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (SQLite default for local development, PostgreSQL for production)
DATABASE_URL="sqlite:///./munchmate.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/munchmate_db"

# Frontend Origin for CORS & Shareable links
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001"

# Payment Configuration
# Modes: "demo", "razorpay"
PAYMENT_MODE="demo"
DEMO_MODE=true

# Direct UPI Receiver Information
UPI_VPA="munchmate@upi"
UPI_PAYEE_NAME="MunchMate Group Pool"

# Optional Razorpay Gateway Credentials (for live gateway mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Default Fee Policies (in integer paise)
DEFAULT_DELIVERY_FEE_PAISE=4000
DEFAULT_PLATFORM_FEE_PAISE=1000
DEFAULT_PACKAGING_FEE_PAISE=1500
DEFAULT_TAX_PERCENTAGE=5.0
